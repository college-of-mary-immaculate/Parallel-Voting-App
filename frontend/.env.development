# Development Environment Variables
NODE_ENV=development

# Application Configuration
VITE_APP_NAME=Parallel Voting App (Dev)
VITE_APP_VERSION=1.0.0-dev
VITE_APP_DESCRIPTION=Development environment for voting platform

# API Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=1

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=true

# Performance Configuration
VITE_BUNDLE_ANALYZER=false
VITE_SOURCE_MAP=true
VITE_MINIFY=false
VITE_TREESHAKING=true

# Security Configuration
VITE_ENABLE_CSP=false
VITE_ENABLE_HSTS=false
VITE_SECURE_COOKIES=false

# Analytics and Monitoring
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_ERROR_REPORTING_ENDPOINT=

# CDN Configuration
VITE_CDN_URL=
VITE_STATIC_URL=

# Cache Configuration
VITE_CACHE_VERSION=v1.0.0-dev
VITE_CACHE_DURATION=0

# PWA Configuration
VITE_PWA_NAME=VoteApp (Dev)
VITE_PWA_SHORT_NAME=VoteApp
VITE_PWA_THEME_COLOR=#4F46E5
VITE_PWA_BACKGROUND_COLOR=#FFFFFF

# Build Configuration
VITE_BUILD_DATE=2024-01-01T00:00:00Z
VITE_BUILD_COMMIT=unknown
VITE_BUILD_BRANCH=development
