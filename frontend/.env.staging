# Staging Environment Variables
NODE_ENV=production

# Application Configuration
VITE_APP_NAME=Parallel Voting App (Staging)
VITE_APP_VERSION=1.0.0-staging
VITE_APP_DESCRIPTION=Staging environment for voting platform

# API Configuration
VITE_API_BASE_URL=https://staging-api.voteapp.com
VITE_API_TIMEOUT=10000
VITE_API_RETRY_ATTEMPTS=3

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=true

# Performance Configuration
VITE_BUNDLE_ANALYZER=true
VITE_SOURCE_MAP=true
VITE_MINIFY=true
VITE_TREESHAKING=true

# Security Configuration
VITE_ENABLE_CSP=true
VITE_ENABLE_HSTS=false
VITE_SECURE_COOKIES=false

# Analytics and Monitoring
VITE_ANALYTICS_ID=GA-STAGING-XXXXXXXXX
VITE_SENTRY_DSN=https://xxxxx@sentry.io/staging-xxxxx
VITE_ERROR_REPORTING_ENDPOINT=https://staging-errors.voteapp.com/report

# CDN Configuration
VITE_CDN_URL=https://staging-cdn.voteapp.com
VITE_STATIC_URL=https://staging-static.voteapp.com

# Cache Configuration
VITE_CACHE_VERSION=v1.0.0-staging
VITE_CACHE_DURATION=3600

# PWA Configuration
VITE_PWA_NAME=VoteApp (Staging)
VITE_PWA_SHORT_NAME=VoteApp
VITE_PWA_THEME_COLOR=#4F46E5
VITE_PWA_BACKGROUND_COLOR=#FFFFFF

# Build Configuration
VITE_BUILD_DATE=2024-01-01T00:00:00Z
VITE_BUILD_COMMIT=unknown
VITE_BUILD_BRANCH=staging
