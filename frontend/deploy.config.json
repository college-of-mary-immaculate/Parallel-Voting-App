{
  "environments": {
    "staging": {
      "host": "staging.voteapp.com",
      "path": "/var/www/staging",
      "user": "deploy",
      "commands": {
        "upload": "rsync -avz --delete dist/ deploy@staging.voteapp.com:/var/www/staging/",
        "restart": "ssh deploy@staging.voteapp.com 'sudo systemctl reload nginx'",
        "healthCheck": "curl -f -s https://staging.voteapp.com/health"
      },
      "healthCheck": {
        "url": "https://staging.voteapp.com/health",
        "timeout": 30000,
        "retries": 3
      },
      "notifications": {
        "slack": {
          "webhook": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK",
          "channel": "#deployments",
          "username": "DeployBot"
        },
        "email": {
          "recipients": ["dev-team@voteapp.com"],
          "subject": "Deployment to Staging"
        }
      },
      "rollback": {
        "command": "ssh deploy@staging.voteapp.com 'sudo systemctl rollback staging'"
      }
    },
    "production": {
      "host": "voteapp.com",
      "path": "/var/www/production",
      "user": "deploy",
      "commands": {
        "upload": "rsync -avz --delete dist/ deploy@voteapp.com:/var/www/production/",
        "restart": "ssh deploy@voteapp.com 'sudo systemctl reload nginx'",
        "healthCheck": "curl -f -s https://voteapp.com/health"
      },
      "healthCheck": {
        "url": "https://voteapp.com/health",
        "timeout": 60000,
        "retries": 5
      },
      "notifications": {
        "slack": {
          "webhook": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK",
          "channel": "#deployments",
          "username": "DeployBot"
        },
        "email": {
          "recipients": ["dev-team@voteapp.com", "ops-team@voteapp.com"],
          "subject": "Deployment to Production"
        }
      },
      "rollback": {
        "command": "ssh deploy@voteapp.com 'sudo systemctl rollback production'"
      }
    }
  },
  "global": {
    "timeout": 300000,
    "retries": 3,
    "notifications": {
      "enabled": true,
      "onSuccess": true,
      "onFailure": true,
      "onRollback": true
    }
  }
}
