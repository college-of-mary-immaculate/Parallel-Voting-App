# Production Environment Variables

### DATABASE CONFIGURATION ###
MASTER_DB_HOST=mysql_master
MASTER_DB_USER=voting_user
MASTER_DB_PASS=voting_password
MASTER_DB_NAME=voting_db
MASTER_DB_PORT=3306

SLAVE_DB_HOST=mysql_slave1
SLAVE_DB_USER=voting_user
SLAVE_DB_PASS=voting_password
SLAVE_DB_NAME=voting_db
SLAVE_DB_PORT=3306

### BACKEND CONFIGURATION ###
API_HOST=localhost
API_KEY=voteph_production
NODE_ENV=production

### FRONTEND CONFIGURATION ###
HOST=localhost
PORT=3000

### REDIS CONFIGURATION ###
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

### SOCKET.IO CONFIGURATION ###
SERVER_NAME=app_server1
PORTS=app_server2:3001,app_server3:3002
PUBLISHER=true

### SECURITY ###
JWT_SECRET=your_super_secret_jwt_key_here_production
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

### EMAIL CONFIGURATION ###
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

### GOOGLE OAUTH (OPTIONAL) ###
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

### MONITORING & LOGGING ###
LOG_LEVEL=info
ENABLE_METRICS=true
ENABLE_AUDIT_LOG=true

### RATE LIMITING ###
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

### CACHE CONFIGURATION ###
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
